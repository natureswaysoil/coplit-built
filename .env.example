# ---- Core site ----
# Public absolute site URL (no trailing slash)
PUBLIC_SITE_URL=https://natureswaysoil.com

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CUSTOMERS_TABLE=customers
SUPABASE_ORDERS_TABLE=orders
SUPABASE_TAXCODE_TABLE=product_tax_codes

# ---- Stripe ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Prefer STRIPE_API_KEY; fallback STRIPE_SECRET_KEY also supported
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM="Nature's Way Soil <no-reply@natureswaysoil.com>"
SUPPORT_TO=support@natureswaysoil.com
SALES_TO=sales@natureswaysoil.com
DMARC=v=DMARC1; p=none; rua=mailto:dmarc@natureswaysoil.com; ruf=mailto:dmarc@natureswaysoil.com; fo=1

# ---- Admin & security ----
ADMIN_API_TOKEN=
ADMIN_USER=
ADMIN_PASSWORD=
ALERT_COOLDOWN_MINUTES=180
ALERT_UNSUBSCRIBE_SECRET=
REVALIDATE_SECRET=

# ---- Tax config ----
# Base NC rate (decimal), county add-ons resolved dynamically
NEXT_PUBLIC_NC_TAX_RATE=0.0475
# Shipping taxable for NC
NC_TAX_TAXABLE_SHIPPING=true
# Optional: override/add county rates as JSON mapping
# NEXT_PUBLIC_NC_COUNTY_RATES={"wake":0.02,"durham":0.0225}

# ---- Contentful (optional legacy) ----
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master
